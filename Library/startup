#!/bin/bash

shopt -s nullglob
. "$(dirname "${BASH_SOURCE[0]}")/package-paths.sh"
export PATH=${CYDIA_BIN}:$PATH:/usr/sbin:/usr/bin:/sbin:/bin

if [[ ! -e "${CYDIA_STATE}/firmware.ver" ]]; then
    cache=
fi

"${CYDIA_LIBEXEC}/firmware.sh"

autoinstall=${CYDIA_AUTOINSTALL_DIR:-/var/root/Media/Cydia/AutoInstall}
debs=("${autoinstall}"/*.deb)
if [[ ${#debs[@]} -ne 0 && -f ${debs[0]} ]]; then
    "${CYDIA_LIBEXEC}/cydo" -i "${debs[@]}" 2>/tmp/dpkg.log 1>&2
    rm -f "${debs[@]}"
    cache=

    killall -9 Lowtide AppleTV
fi

if [[ ${cache+@} ]]; then
    sbdidlaunch
    su -c uicache mobile
fi
