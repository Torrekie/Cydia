#!/bin/bash

shopt -s nullglob
. "$(dirname "${BASH_SOURCE[0]}")/package-paths.sh"
export PATH=${CYDIA_BOOTSTRAP_PATH}

if [[ ! -e "${CYDIA_STATE}/firmware.ver" ]]; then
    cache=
fi

"${CYDIA_LIBEXEC}/firmware.sh"

autoinstall=${CYDIA_AUTOINSTALL_DIR:-${CYDIA_PREFIX}/var/root/Media/Cydia/AutoInstall}
debs=("${autoinstall}"/*.deb)
if [[ ${#debs[@]} -ne 0 && -f ${debs[0]} ]]; then
    if "${CYDIA_DPKG}" -i "${debs[@]}" 2>/tmp/dpkg.log 1>&2; then
        "${CYDIA_BSD_BIN}/rm" -f "${debs[@]}"
        cache=

        killall -9 Lowtide AppleTV
    else
        echo "Cydia AutoInstall failed; preserving packages for retry" >&2
    fi
fi

if [[ ${cache+@} ]]; then
    sbdidlaunch
    su -c uicache mobile
fi
