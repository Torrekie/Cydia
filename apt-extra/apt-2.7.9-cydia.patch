--- /dev/null
+++ b/test/integration/test-cydia-repository-security
@@ -0,0 +1,108 @@
+#!/bin/sh
+# Cydia's process-local trust policy does not change normal APT callers.
+set -e
+TESTDIR="$(readlink -f "$(dirname "$0")")"
+. "$TESTDIR/framework"
+setupenvironment
+configarchitecture 'i386'
+configcompression '.'
+buildsimplenativepackage 'policy-test' 'i386' '1.0' 'unstable'
+
+policyupdate() {
+    aptget update -o "Cydia::RepositorySecurityMode=$MODE" \
+        -o Acquire::AllowInsecureRepositories=true \
+        -o Acquire::AllowWeakRepositories=true \
+        -o Acquire::AllowDowngradeToInsecureRepositories=true \
+        -o APT::Get::List-Cleanup=false -o Acquire::By-Hash=false "$@"
+}
+resetarchive() {
+    rm -rf rootdir/var/lib/apt/lists
+    setupaptarchive --no-update
+    # Error must override even explicit per-source bypasses, without editing
+    # the source document. Warning/Allow must still mark packages untrusted.
+    sed -i 's#^deb\(-src\)\? #deb\1 [trusted=yes allow-insecure=yes allow-weak=yes allow-downgrade-to-insecure=yes] #' rootdir/etc/apt/sources.list.d/*.list
+}
+for OMIT in Release.gpg InRelease; do
+export APT_DONT_SIGN="$OMIT"
+for MODE in allow warning error; do
+    resetarchive
+    testsuccess policyupdate
+    listcurrentlistsdirectory > lists.before
+    BADFILE=aptarchive/dists/unstable/InRelease
+    if [ "$OMIT" = InRelease ]; then BADFILE=aptarchive/dists/unstable/Release; fi
+    sed -i 's/^Codename:.*/Codename: tampered/' "$BADFILE"
+    touch -d '+1 minute' "$BADFILE"
+    # BADSIG is always a hard error, also with authenticated cached indexes.
+    testfailure policyupdate
+    testfileequal lists.before "$(listcurrentlistsdirectory)"
+
+    resetarchive
+    testsuccess policyupdate
+    if [ "$OMIT" = InRelease ]; then
+        printf 'invalid signature data\n' > aptarchive/dists/unstable/Release.gpg
+        touch -d '+1 minute' aptarchive/dists/unstable/Release.gpg
+    else
+        cp aptarchive/dists/unstable/Release aptarchive/dists/unstable/InRelease
+        touch -d '+1 minute' aptarchive/dists/unstable/InRelease
+    fi
+    # Plain/malformed signature data is not an unsigned-repository fallback.
+    testfailure policyupdate
+
+    resetarchive
+    testsuccess policyupdate
+    rm -f aptarchive/dists/unstable/InRelease aptarchive/dists/unstable/Release.gpg
+    if [ "$MODE" = error ]; then
+        testfailure policyupdate
+    else
+        testsuccess policyupdate
+        # List-Cleanup=false must not retain stale signatures implying trust.
+        testempty find rootdir/var/lib/apt/lists -name '*InRelease' -o -name '*Release.gpg'
+        testfailure aptget install policy-test -y --download-only \
+            -o "Cydia::RepositorySecurityMode=$MODE"
+    fi
+
+    resetarchive
+    # Unknown and expired/revoked keys are authentication policy failures,
+    # whereas a signature mismatch above is an integrity failure.
+    signreleasefiles 'Marvin Paranoid'
+    if [ "$MODE" = error ]; then
+        testfailure policyupdate
+    else
+        testsuccess policyupdate
+    fi
+    resetarchive
+    signreleasefiles 'Rex Expired'
+    if [ "$MODE" = error ]; then
+        testfailure policyupdate
+    else
+        testsuccess policyupdate
+    fi
+
+    resetarchive
+    # A syntactically damaged Release is not merely weak metadata.
+    printf 'SHA256:\n malformed-entry\n' > aptarchive/dists/unstable/Release
+    signreleasefiles
+    testfailure policyupdate
+
+    resetarchive
+    # Keep authentic metadata, but damage the referenced downloaded index.
+    echo 'tampered index' >> aptarchive/dists/unstable/main/binary-i386/Packages
+    testfailure policyupdate
+    resetarchive
+    testsuccess policyupdate
+    sed -i '/^SHA256:/,$d' aptarchive/dists/unstable/Release
+    signreleasefiles
+    if [ "$MODE" = error ]; then
+        testfailure policyupdate
+    else
+        testsuccess policyupdate
+    fi
+    resetarchive
+    find aptarchive/dists/unstable -name '*Release*' -delete
+    if [ "$MODE" = error ]; then
+        testfailure policyupdate
+    else
+        testsuccess policyupdate
+    fi
+done
+done
