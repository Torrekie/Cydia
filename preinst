#!/bin/bash

declare -a cydia
cydia=($CYDIA)

normalize_install_root() {
    local root=$1
    [[ -n "$root" && "$root" == /* ]] || return 1
    [[ "$root" == "/" ]] && { printf '/\n'; return 0; }
    case "$root" in
        *//*|*/./*|*/../*|*/.|*/..) return 1 ;;
    esac
    while [[ "$root" != "/" && "$root" == */ ]]; do
        root=${root%/}
    done
    printf '%s\n' "$root"
}

# The old package shipped a global sourceparts file.  Before dpkg updates its
# file list, preserve that path only when the installed Cydia package actually
# listed it.  APT silently ignores a suffix ending in .disabled, while the
# rename keeps
# user edits and symlink targets recoverable instead of deleting or replacing
# them.  The active root comes from dpkg, so an unrelated rooted/rootless
# installation is never touched.
resolve_install_prefix() {
    local root admin candidate candidate_prefix match_count=0 match_prefix=""
    root=${DPKG_ROOT:-}
    if [[ -n "$root" ]]; then
        root=$(normalize_install_root "$root") || return 1
    fi
    admin=${DPKG_ADMINDIR:-}
    if [[ -n "$admin" ]]; then
        [[ "$admin" == /* ]] || return 1
        case "$admin" in
            *//*|*/./*|*/../*|*/.|*/..) return 1 ;;
        esac
        while [[ "$admin" != "/" && "$admin" == */ ]]; do
            admin=${admin%/}
        done
    fi
    case "$admin" in
        /var/lib/dpkg|/Library/dpkg)
            if [[ -n "$root" && "$root" != "/" ]]; then
                [[ "$root" == /* ]] || return 1
                printf '%s\n' "$root"
            else
                printf '%s\n' ""
            fi
            ;;
        */var/lib/dpkg)
            printf '%s\n' "${admin%/var/lib/dpkg}"
            ;;
        */Library/dpkg)
            printf '%s\n' "${admin%/Library/dpkg}"
            ;;
        "")
            # Some Darwin dpkg builds do not export DPKG_ADMINDIR to
            # maintainer scripts.  Infer the active root only when exactly
            # one known Cydia admin directory still proves ownership of the
            # legacy path; ambiguity fails closed.
            for candidate in /var/lib/dpkg /Library/dpkg \
                    /var/jb/var/lib/dpkg /var/jb/Library/dpkg; do
                [[ -f "$candidate/info/cydia.list" ]] || continue
                case "$candidate" in
                    /var/lib/dpkg|/Library/dpkg) candidate_prefix="" ;;
                    /var/jb/var/lib/dpkg|/var/jb/Library/dpkg) candidate_prefix="/var/jb" ;;
                    *) continue ;;
                esac
                legacy_source_listed "$candidate/info/cydia.list" "$candidate_prefix" || continue
                match_count=$((match_count + 1))
                match_prefix=$candidate_prefix
            done
            [[ $match_count -eq 1 ]] || return 1
            printf '%s\n' "$match_prefix"
            ;;
        *)
            # An unfamiliar administrative layout may belong to another
            # bootstrap; do not guess its sourceparts root.
            return 1
            ;;
    esac
}

legacy_source_listed() {
    local file_list=$1 prefix=$2 prefix_relative candidate normalized
    [[ -f "$file_list" ]] || return 1

    prefix_relative=${prefix#/}
    while IFS= read -r candidate; do
        normalized=${candidate#./}
        normalized=${normalized#/}
        [[ "$normalized" == 'etc/apt/sources.list.d/cydia.list' ]] && return 0
        if [[ -n "$prefix_relative" &&
              "$normalized" == "$prefix_relative/etc/apt/sources.list.d/cydia.list" ]]; then
            return 0
        fi
    done <"$file_list"
    return 1
}

choose_legacy_backup() {
    local source=$1 candidate index=0
    candidate="${source}.cydia.disabled"
    while [[ -e "$candidate" || -L "$candidate" ]]; do
        index=$((index + 1))
        [[ $index -le 100 ]] || return 1
        candidate="${source}.cydia.${index}.disabled"
    done
    printf '%s\n' "$candidate"
}

# Keep the handoff receipt in Cydia's durable state directory.  dpkg treats
# files below its info directory as package metadata and may remove an
# unlisted marker while unpacking the new control files, before postinst can
# consume it.  The state directory is package-owned but is intentionally not
# swept by dpkg's info-file cleanup.  The prefix is already normalized and
# provenance-checked by resolve_install_prefix.
legacy_source_marker_path() {
    local prefix=$1
    [[ -z "$prefix" || "$prefix" == /* ]] || return 1
    printf '%s/var/lib/cydia/cydia.legacy-source-marker\n' "$prefix"
}

legacy_source_marker_parent_is_safe() {
    local marker=$1 parent=${marker%/*}
    [[ "$parent" != "$marker" && -d "$parent" && ! -L "$parent" ]] || return 1
    return 0
}

# Return success only for a source path that APT would actually consume.  A
# symlink, non-regular path, or unreadable file is deliberately treated as
# active even when its target/content is currently unavailable: moving and
# restoring the exact object is safer than guessing whether it is inert.  A
# readable regular file is active only when it contains a non-comment line;
# empty and comment-only siblings are ignored by APT and therefore do not
# prevent a sole-source handoff.
source_path_is_active() {
    local path=$1 line read_status
    [[ -e "$path" || -L "$path" ]] || return 1
    [[ -L "$path" ]] && return 0
    [[ -f "$path" ]] || return 0
    [[ -r "$path" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        [[ -z "$line" || "${line#\#}" != "$line" ]] && continue
        return 0
    done <"$path"
    read_status=$?
    # A clean EOF (including an empty/comment-only file) exits the loop with
    # status zero.  Any redirection/read error is conservatively considered
    # active so the sole-source path cannot be disabled on incomplete input.
    [[ $read_status -eq 0 ]] && return 1
    return 0
}

source_parts_has_other_active() {
    local parts=$1 source=$2 candidate
    [[ -d "$parts" ]] || return 0
    for candidate in "$parts"/*.list "$parts"/*.sources; do
        [[ -e "$candidate" || -L "$candidate" ]] || continue
        [[ "$candidate" == "$source" ]] && continue
        if source_path_is_active "$candidate"; then
            return 0
        fi
    done
    return 1
}

find_apt_config_binary() {
    local candidate
    candidate=$(command -v apt-config 2>/dev/null) || candidate=
    [[ "$candidate" == */apt-config && -x "$candidate" ]] || return 1
    printf '%s\n' "$candidate"
}

# apt-config shell output is intentionally parsed without eval.  Only the
# simple, path-safe spelling emitted by APT is accepted; shell escapes and
# control characters make the effective configuration ambiguous and therefore
# fail closed.
apt_config_shell_value() {
    local binary=$1 alias=$2 key=$3 output line value
    output=$("$binary" shell "$alias" "$key" 2>/dev/null) || return 1
    line=$(printf '%s\n' "$output" | sed -n "s/^${alias}=//p")
    # A few bootstrap wrappers append a harmless statement terminator even
    # though upstream apt-config does not.  Strip only that final byte and
    # surrounding horizontal whitespace.
    line=$(printf '%s\n' "$line" | sed -E 's/[[:space:]]*;[[:space:]]*$//')
    [[ -n "$line" && "$line" != *$'\n'* && "$line" != *$'\r'* ]] || return 1
    case "$line" in
        \'*\') value=${line#\'}; value=${value%\'} ;;
        *) return 1 ;;
    esac
    [[ "$value" != *\\* && "$value" != *$'\n'* && "$value" != *$'\r'* ]] || return 1
    printf '%s\n' "$value"
}

apt_config_path_mentions_prefix() {
    local raw=$1 prefix=$2 relative
    [[ -n "$prefix" && -n "$raw" ]] || return 1
    relative=${prefix#/}
    [[ "$raw" == "$prefix" || "$raw" == "$prefix/"* ||
          "$raw" == "$relative" || "$raw" == "$relative/"* ]] && return 0
    return 1
}

apt_config_reports_prefix() {
    local prefix=$1
    apt_config_path_mentions_prefix "$APT_CONFIG_ROOT_RAW" "$prefix" ||
        apt_config_path_mentions_prefix "$APT_CONFIG_DIR_RAW" "$prefix" ||
        apt_config_path_mentions_prefix "$APT_CONFIG_ETC_RAW" "$prefix" ||
        apt_config_path_mentions_prefix "$APT_CONFIG_MAIN_RAW" "$prefix" ||
        apt_config_path_mentions_prefix "$APT_CONFIG_PARTS_RAW" "$prefix"
}

apt_config_file_is_under_prefix() {
    local file=$1 prefix=$2 relative
    [[ -n "$prefix" && -n "$file" ]] || return 1
    relative=${prefix#/}
    [[ "$file" == "$prefix"/* || "$file" == "$relative"/* ]] && return 0
    return 1
}

apt_config_value_from_file() {
    local file=$1 key=$2 line value result found=0 regex trimmed remainder
    regex="^[[:space:]]*${key}[[:space:]]+\"?([^\";[:space:]]+)\"?[[:space:]]*;[[:space:]]*(#.*)?$"
    while IFS= read -r line || [[ -n "$line" ]]; do
        value=
        # Ignore comments, but reject nested/escaped forms below instead of
        # silently treating them as defaults.
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        if [[ "$line" =~ $regex ]]; then
            value=${BASH_REMATCH[1]}
            [[ $found -eq 0 ]] || return 2
            found=1
            result=$value
            continue
        fi
        # A relevant token in a form we cannot parse (nested braces, #clear,
        #include, or an unquoted value containing whitespace) is ambiguous.
        # Match the key as a token, not as a prefix (Dir::Etc must not mistake
        # a perfectly valid Dir::Etc::sourceparts assignment for an unknown
        # nested form).
        trimmed=${line#"${line%%[![:space:]]*}"}
        if [[ "$trimmed" == "$key"* ]]; then
            remainder=${trimmed#"$key"}
            case "$remainder" in
                ''|[[:space:]]*|';'*|\"*|\'*|=*) return 2 ;;
            esac
        fi
    done <"$file" || return 2
    if [[ $found -eq 1 ]]; then
        printf '%s\n' "$result"
        return 0
    fi
    return 1
}

manual_apt_config_file() {
    local file=$1 value status
    [[ -f "$file" && -r "$file" ]] || return 1
    # APT also permits nested `Dir { ... }` blocks and #clear/#include
    # directives.  We cannot resolve those safely in a maintainer script, so
    # reject them before the simple direct-assignment parser below.
    if grep -Eq '^[[:space:]]*(Dir|RootDir)[[:space:]]*\{|^[[:space:]]*(sourcelist|sourceparts)[[:space:]]+|^[[:space:]]*#(clear|include|import)' "$file"; then
        return 1
    fi
    value=$(apt_config_value_from_file "$file" Dir) ; status=$?
    if [[ $status -eq 0 ]]; then
        [[ ${APT_CONFIG_DIR_SEEN:-0} -eq 0 ]] || return 1
        APT_CONFIG_DIR_SEEN=1; APT_CONFIG_DIR_RAW=$value
    elif [[ $status -ne 1 ]]; then return 1; fi

    value=$(apt_config_value_from_file "$file" RootDir) ; status=$?
    if [[ $status -eq 0 ]]; then
        [[ ${APT_CONFIG_ROOT_SEEN:-0} -eq 0 ]] || return 1
        APT_CONFIG_ROOT_SEEN=1; APT_CONFIG_ROOT_RAW=$value
    elif [[ $status -ne 1 ]]; then return 1; fi

    value=$(apt_config_value_from_file "$file" Dir::Etc) ; status=$?
    if [[ $status -eq 0 ]]; then
        [[ ${APT_CONFIG_ETC_SEEN:-0} -eq 0 ]] || return 1
        APT_CONFIG_ETC_SEEN=1; APT_CONFIG_ETC_RAW=$value
    elif [[ $status -ne 1 ]]; then return 1; fi

    value=$(apt_config_value_from_file "$file" Dir::Etc::sourcelist) ; status=$?
    if [[ $status -eq 0 ]]; then
        [[ ${APT_CONFIG_MAIN_SEEN:-0} -eq 0 ]] || return 1
        APT_CONFIG_MAIN_SEEN=1; APT_CONFIG_MAIN_RAW=$value
    elif [[ $status -ne 1 ]]; then return 1; fi

    value=$(apt_config_value_from_file "$file" Dir::Etc::sourceparts) ; status=$?
    if [[ $status -eq 0 ]]; then
        [[ ${APT_CONFIG_PARTS_SEEN:-0} -eq 0 ]] || return 1
        APT_CONFIG_PARTS_SEEN=1; APT_CONFIG_PARTS_RAW=$value
    elif [[ $status -ne 1 ]]; then return 1; fi

    value=$(apt_config_value_from_file "$file" Dir::Etc::main) ; status=$?
    if [[ $status -eq 0 ]]; then
        [[ ${APT_CONFIG_MAIN_FILE_SEEN:-0} -eq 0 ]] || return 1
        APT_CONFIG_MAIN_FILE_SEEN=1; APT_CONFIG_MAIN_FILE_RAW=$value
    elif [[ $status -ne 1 ]]; then return 1; fi

    value=$(apt_config_value_from_file "$file" Dir::Etc::parts) ; status=$?
    if [[ $status -eq 0 ]]; then
        [[ ${APT_CONFIG_PARTS_DIR_SEEN:-0} -eq 0 ]] || return 1
        APT_CONFIG_PARTS_DIR_SEEN=1; APT_CONFIG_PARTS_DIR_RAW=$value
    elif [[ $status -ne 1 ]]; then return 1; fi
    return 0
}

configured_path_is_standard() {
    local raw=$1 expected=$2 leaf=$3 prefix=$4
    [[ -n "$raw" ]] || return 1
    [[ "$raw" == "$expected" || "$raw" == "${expected#/}" ]] && return 0
    [[ "$raw" == "$leaf" || "$raw" == "etc/apt/$leaf" ||
          "$raw" == "/etc/apt/$leaf" ]] &&
        [[ "$expected" == "${prefix}/etc/apt/$leaf" ]] && return 0
    if [[ -n "$prefix" ]]; then
        local relative=${prefix#/}
        [[ "$raw" == "$relative/etc/apt/$leaf" ||
              "$raw" == "/$relative/etc/apt/$leaf" ]] && return 0
    fi
    return 1
}

apt_etc_is_standard() {
    local raw=$1 prefix=$2 expected="${prefix}/etc/apt"
    [[ -z "$raw" || "$raw" == "$expected" || "$raw" == "${expected#/}" ||
          "$raw" == "etc/apt" || "$raw" == "/etc/apt" ]] && return 0
    return 1
}

apt_parent_dir_is_standard() {
    local raw=$1 prefix=$2
    [[ -z "$raw" || "$raw" == "/" || "$raw" == "$prefix" ||
          "$raw" == "${prefix#/}" ]] && return 0
    return 1
}

apt_config_file_is_standard() {
    local raw=$1 expected=$2 leaf=$3 prefix=$4
    [[ -n "$raw" ]] || return 1
    [[ "$raw" == "$expected" || "$raw" == "${expected#/}" ||
          "$raw" == "$leaf" || "$raw" == "etc/apt/$leaf" ||
          "$raw" == "/etc/apt/$leaf" ]] && return 0
    if [[ -n "$prefix" ]]; then
        local relative=${prefix#/}
        [[ "$raw" == "$relative/etc/apt/$leaf" ||
              "$raw" == "/$relative/etc/apt/$leaf" ]] && return 0
    fi
    return 1
}

apt_root_is_standard() {
    local raw=$1 prefix=$2
    [[ -z "$raw" || "$raw" == "/" || "$raw" == "$prefix" ||
          "$raw" == "${prefix#/}" ]] && return 0
    return 1
}

apt_config_values_are_standard() {
    local prefix=$1
    local expected_main="${prefix}/etc/apt/sources.list"
    local expected_parts="${prefix}/etc/apt/sources.list.d"
    local expected_main_file="${prefix}/etc/apt/apt.conf"
    local expected_parts_dir="${prefix}/etc/apt/apt.conf.d"
    configured_path_is_standard "$APT_CONFIG_MAIN_RAW" "$expected_main" \
        sources.list "$prefix" || return 1
    configured_path_is_standard "$APT_CONFIG_PARTS_RAW" "$expected_parts" \
        sources.list.d "$prefix" || return 1
    apt_etc_is_standard "$APT_CONFIG_ETC_RAW" "$prefix" || return 1
    apt_root_is_standard "$APT_CONFIG_ROOT_RAW" "$prefix" || return 1
    apt_parent_dir_is_standard "$APT_CONFIG_DIR_RAW" "$prefix" || return 1
    apt_config_file_is_standard "$APT_CONFIG_MAIN_FILE_RAW" \
        "$expected_main_file" apt.conf "$prefix" || return 1
    apt_config_file_is_standard "$APT_CONFIG_PARTS_DIR_RAW" \
        "$expected_parts_dir" apt.conf.d "$prefix" || return 1
    return 0
}

# Populate the raw effective APT values and accept only the standard physical
# Cydia layout.  If apt-config is unavailable, direct one-line apt.conf values
# are parsed; unsupported/custom forms deliberately fail closed.
effective_apt_paths_are_standard() {
    local prefix=$1 binary main_raw parts_raw config_dir file
    local expected_main="${prefix}/etc/apt/sources.list"
    local expected_parts="${prefix}/etc/apt/sources.list.d"
    local expected_main_file="${prefix}/etc/apt/apt.conf"
    local expected_parts_dir="${prefix}/etc/apt/apt.conf.d"
    APT_CONFIG_MAIN_RAW=
    APT_CONFIG_PARTS_RAW=
    APT_CONFIG_ETC_RAW=
    APT_CONFIG_ROOT_RAW=
    APT_CONFIG_DIR_RAW=
    APT_CONFIG_MAIN_FILE_RAW=
    APT_CONFIG_PARTS_DIR_RAW=
    APT_CONFIG_MAIN_SEEN=0
    APT_CONFIG_PARTS_SEEN=0
    APT_CONFIG_ETC_SEEN=0
    APT_CONFIG_ROOT_SEEN=0
    APT_CONFIG_DIR_SEEN=0
    APT_CONFIG_MAIN_FILE_SEEN=0
    APT_CONFIG_PARTS_DIR_SEEN=0

    binary=$(find_apt_config_binary) || binary=
    if [[ -n "$binary" ]]; then
        main_raw=$(apt_config_shell_value "$binary" CydiaSourceList Dir::Etc::sourcelist) || return 1
        parts_raw=$(apt_config_shell_value "$binary" CydiaSourceParts Dir::Etc::sourceparts) || return 1
        APT_CONFIG_MAIN_RAW=$main_raw
        APT_CONFIG_PARTS_RAW=$parts_raw
        # These optional values let us reject a custom Dir::Etc/RootDir while
        # retaining compatibility with apt-config builds that omit defaults.
        APT_CONFIG_ETC_RAW=$(apt_config_shell_value "$binary" CydiaEtc Dir::Etc) || APT_CONFIG_ETC_RAW=
        APT_CONFIG_ROOT_RAW=$(apt_config_shell_value "$binary" CydiaRoot RootDir) || APT_CONFIG_ROOT_RAW=
        APT_CONFIG_DIR_RAW=$(apt_config_shell_value "$binary" CydiaDir Dir) || APT_CONFIG_DIR_RAW=
        APT_CONFIG_MAIN_FILE_RAW=$(apt_config_shell_value "$binary" CydiaMain Dir::Etc::main) || APT_CONFIG_MAIN_FILE_RAW=
        APT_CONFIG_PARTS_DIR_RAW=$(apt_config_shell_value "$binary" CydiaParts Dir::Etc::parts) || APT_CONFIG_PARTS_DIR_RAW=
        # DPKG_ROOT does not automatically alter apt-config's process root.
        # If an alternate root is active, trust the binary only when its
        # reported values carry that prefix.  Otherwise fall back to parsing
        # the rooted files below; an explicit APT_CONFIG outside that root is
        # ambiguous and therefore fails closed.
        if [[ -n "$prefix" ]] && ! apt_config_reports_prefix "$prefix"; then
            # A binary that reports an actually custom path is evidence of a
            # nonstandard effective configuration, not a reason to discard
            # that value and accept rooted defaults.  Validate the report
            # against the standard spellings before deciding to fall back.
            APT_CONFIG_MAIN_RAW=${APT_CONFIG_MAIN_RAW:-sources.list}
            APT_CONFIG_PARTS_RAW=${APT_CONFIG_PARTS_RAW:-sources.list.d}
            APT_CONFIG_ETC_RAW=${APT_CONFIG_ETC_RAW:-etc/apt}
            APT_CONFIG_ROOT_RAW=${APT_CONFIG_ROOT_RAW:-/}
            APT_CONFIG_DIR_RAW=${APT_CONFIG_DIR_RAW:-/}
            APT_CONFIG_MAIN_FILE_RAW=${APT_CONFIG_MAIN_FILE_RAW:-apt.conf}
            APT_CONFIG_PARTS_DIR_RAW=${APT_CONFIG_PARTS_DIR_RAW:-apt.conf.d}
            apt_config_values_are_standard "$prefix" || return 1
            if [[ -n "${APT_CONFIG:-}" ]] &&
                    ! apt_config_file_is_under_prefix "$APT_CONFIG" "$prefix"; then
                return 1
            fi
            binary=
            APT_CONFIG_MAIN_RAW=
            APT_CONFIG_PARTS_RAW=
            APT_CONFIG_ETC_RAW=
            APT_CONFIG_ROOT_RAW=
            APT_CONFIG_DIR_RAW=
            APT_CONFIG_MAIN_FILE_RAW=
            APT_CONFIG_PARTS_DIR_RAW=
        fi
    fi
    if [[ -z "$binary" ]]; then
        if [[ -n "${APT_CONFIG:-}" ]]; then
            [[ "$APT_CONFIG" == /* && -f "$APT_CONFIG" ]] || return 1
            if [[ -n "$prefix" ]] &&
                    ! apt_config_file_is_under_prefix "$APT_CONFIG" "$prefix"; then
                return 1
            fi
            manual_apt_config_file "$APT_CONFIG" || return 1
        fi
        config_dir="${prefix}/etc/apt"
        # APT reads an explicit APT_CONFIG first, then apt.conf.d fragments in
        # lexical order, and finally the main apt.conf.  Reject duplicate
        # assignments rather than risking a precedence-dependent guess.
        for file in "$config_dir/apt.conf.d"/*; do
            [[ -f "$file" ]] || continue
            [[ "$file" == "${APT_CONFIG:-}" ]] && continue
            manual_apt_config_file "$file" || return 1
        done
        file="$config_dir/apt.conf"
        if [[ -f "$file" && "$file" != "${APT_CONFIG:-}" ]]; then
            manual_apt_config_file "$file" || return 1
        fi
        # No explicit values means APT's documented defaults.
        APT_CONFIG_MAIN_RAW=${APT_CONFIG_MAIN_RAW:-sources.list}
        APT_CONFIG_PARTS_RAW=${APT_CONFIG_PARTS_RAW:-sources.list.d}
        APT_CONFIG_ETC_RAW=${APT_CONFIG_ETC_RAW:-etc/apt}
        APT_CONFIG_DIR_RAW=${APT_CONFIG_DIR_RAW:-/}
        APT_CONFIG_MAIN_FILE_RAW=${APT_CONFIG_MAIN_FILE_RAW:-apt.conf}
        APT_CONFIG_PARTS_DIR_RAW=${APT_CONFIG_PARTS_DIR_RAW:-apt.conf.d}
    fi

    APT_CONFIG_ETC_RAW=${APT_CONFIG_ETC_RAW:-etc/apt}
    APT_CONFIG_DIR_RAW=${APT_CONFIG_DIR_RAW:-/}
    APT_CONFIG_MAIN_FILE_RAW=${APT_CONFIG_MAIN_FILE_RAW:-apt.conf}
    APT_CONFIG_PARTS_DIR_RAW=${APT_CONFIG_PARTS_DIR_RAW:-apt.conf.d}

    apt_config_values_are_standard "$prefix" || return 1
    APT_EFFECTIVE_MAIN=$expected_main
    APT_EFFECTIVE_PARTS=$expected_parts
    return 0
}

legacy_source_is_sole() {
    local prefix=$1 source=$2 main parts
    effective_apt_paths_are_standard "$prefix" || return 1
    main=$APT_EFFECTIVE_MAIN
    parts=$APT_EFFECTIVE_PARTS
    [[ "$source" == "$parts/cydia.list" ]] || return 1
    [[ -d "$parts" ]] || return 1
    source_path_is_active "$source" || return 1
    if source_path_is_active "$main"; then
        return 1
    fi
    source_parts_has_other_active "$parts" "$source" && return 1
    return 0
}

write_legacy_source_marker() {
    local marker=$1 source=$2 backup=$3 parts=$4 main=$5 source_type=$6 marker_tmp
    [[ ! -e "$marker" && ! -L "$marker" ]] || return 1
    marker_tmp="${marker}.tmp.$$"
    if ! (set -C; umask 022; printf '%s\n' \
            'version=2' 'package=cydia' 'mode=sole' 'sole=1' \
            "source=$source" "backup=$backup" "parts=$parts" "main=$main" \
            "source_type=$source_type" >"$marker_tmp") 2>/dev/null; then
        rm -f "$marker_tmp"
        return 1
    fi
    # Publish with a same-directory hard link.  Unlike a final mv, ln without
    # -f fails atomically when another maintainer script won the marker race;
    # the sole-source caller can then roll its source rename back.
    if [[ -e "$marker" || -L "$marker" ]] || ! ln "$marker_tmp" "$marker"; then
        rm -f "$marker_tmp"
        return 1
    fi
    rm -f "$marker_tmp"
    return 0
}

write_legacy_disabled_marker() {
    local marker=$1 source=$2 backup=$3 marker_tmp
    [[ ! -e "$marker" && ! -L "$marker" ]] || return 0
    marker_tmp="${marker}.tmp.$$"
    if ! (set -C; umask 022; printf '%s\n' \
            'version=2' 'package=cydia' 'mode=disabled' 'sole=0' \
            "source=$source" "backup=$backup" >"$marker_tmp") 2>/dev/null; then
        rm -f "$marker_tmp"
        return 0
    fi
    if [[ -e "$marker" || -L "$marker" ]] || ! ln "$marker_tmp" "$marker"; then
        rm -f "$marker_tmp"
    else
        rm -f "$marker_tmp"
    fi
    return 0
}

retire_legacy_source() {
    local prefix admin file_list source marker backup source_type sole=0
    prefix=$(resolve_install_prefix) || return 0

    admin=${DPKG_ADMINDIR:-}
    admin=${admin%/}
    if [[ -z "$admin" ]]; then
        if [[ -n "$prefix" ]]; then
            # Procursus/rootless dpkg uses Library/dpkg; conventional
            # rootful dpkg uses var/lib/dpkg.  Prefer the admin directory
            # that actually contains the ownership proof.
            if [[ -f "${prefix}/Library/dpkg/info/cydia.list" ]]; then
                admin="${prefix}/Library/dpkg"
            else
                admin="${prefix}/var/lib/dpkg"
            fi
        else
            if [[ -f '/Library/dpkg/info/cydia.list' ]]; then
                admin='/Library/dpkg'
            else
                admin='/var/lib/dpkg'
            fi
        fi
    elif [[ ( "$admin" == '/var/lib/dpkg' || "$admin" == '/Library/dpkg' ) && -n "$prefix" ]]; then
        # With --root/DPKG_ROOT, dpkg may expose the in-root admin directory
        # without the root prefix in DPKG_ADMINDIR.
        if [[ "$admin" == '/Library/dpkg' ]]; then
            admin="${prefix}/Library/dpkg"
        else
            admin="${prefix}/var/lib/dpkg"
        fi
    fi
    file_list="${admin}/info/cydia.list"
    source="${prefix}/etc/apt/sources.list.d/cydia.list"
    marker=$(legacy_source_marker_path "$prefix") || return 0

    # No old Cydia file-list proof means this may belong to another package;
    # leave it completely untouched.
    legacy_source_listed "$file_list" "$prefix" || return 0
    if [[ ! -e "$source" && ! -L "$source" ]]; then
        return 0
    fi
    if [[ ! -f "$source" && ! -L "$source" ]]; then
        echo "cydia: refusing to move non-file legacy source path: $source" >&2
        return 1
    fi

    # A sole legacy source is the one compatibility case where removing the
    # old package file would strand the installation with no repositories.  We
    # only mark it when APT's effective physical paths are the documented
    # standard paths and every other source is empty/comment-only.  Unknown or
    # custom layouts intentionally follow the ordinary disabled migration.
    if legacy_source_is_sole "$prefix" "$source"; then
        sole=1
    fi
    if ! legacy_source_marker_parent_is_safe "$marker"; then
        if [[ $sole -eq 1 ]]; then
            echo "cydia: durable legacy source marker directory is unavailable: ${marker%/*}" >&2
            return 1
        fi
        # A non-sole migration is safe without a receipt, but never follow a
        # symlink or otherwise untrusted parent while attempting to write one.
        marker=
    fi
    if [[ -L "$source" ]]; then
        source_type=symlink
    else
        source_type=regular
    fi

    backup=$(choose_legacy_backup "$source") || {
        echo "cydia: no free backup name for legacy source path: $source" >&2
        return 1
    }
    if ! mv "$source" "$backup"; then
        echo "cydia: could not preserve legacy source path: $source" >&2
        return 1
    fi

    if [[ $sole -eq 1 ]]; then
        if ! write_legacy_source_marker "$marker" "$source" "$backup" \
                "${prefix}/etc/apt/sources.list.d" "${prefix}/etc/apt/sources.list" \
                "$source_type"; then
            # A sole source must not be left disabled without a handoff
            # record.  Roll back the exact rename before allowing dpkg to
            # continue; a later invocation can retry if the directory became
            # unwritable or a marker race was observed.
            if [[ -e "$source" || -L "$source" ]] || ! mv "$backup" "$source"; then
                echo "cydia: could not record sole-source migration or roll it back" >&2
            else
                echo "cydia: sole-source migration marker failed; source restored" >&2
            fi
            return 1
        fi
    else
        # Keep a small, non-actionable receipt for diagnostics.  postinst
        # accepts only mode=sole, so this can never recreate a multi-source or
        # custom-layout entry.
        [[ -n "$marker" ]] &&
            write_legacy_disabled_marker "$marker" "$source" "$backup"
    fi
    return 0
}

if ! retire_legacy_source; then
    # Stop before dpkg can remove the old path; the next invocation can retry
    # after the filesystem/permissions issue is corrected.
    exit 1
fi

if [[ $1 == upgrade ]]; then
    if [[ ${CYDIA+@} ]]; then
        if [[ ${cydia[1]} -lt 1 ]]; then
            echo 'PLEASE RESTART CYDIA!'
            echo 'PLEASE RESTART CYDIA!'
            echo 'PLEASE RESTART CYDIA!'
        else
            eval "echo 'finish:reopen' >&${cydia[0]}"
        fi
    fi
fi

exit 0
