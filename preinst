#!/bin/bash
# The package recipe embeds the lifecycle library above this entry point.
if ! declare -F cydia_shared_config_lifecycle >/dev/null; then
    source "$(dirname -- "${BASH_SOURCE[0]}")/Library/shared-config-lifecycle.sh" || exit 1
fi
cydia_shared_config_lifecycle preinst "$@" || exit 1

if [[ "${1:-}" == upgrade && -n "${CYDIA:-}" ]]; then
    read -r cydia_fd cydia_protocol cydia_extra <<< "$CYDIA"
    if [[ "$cydia_fd" =~ ^[0-9]+$ && "$cydia_protocol" =~ ^[0-9]+$ && -z "$cydia_extra" ]]; then
        if (( cydia_protocol < 1 )); then
            printf 'PLEASE RESTART CYDIA!\n'
        else
            printf 'finish:reopen\n' >&"$cydia_fd"
        fi
    fi
fi
exit 0
